{
	"name": "cli-migrations-postgres",
	"private": true,
	"type": "module",
	"scripts": {
		"compile": "tsc -p tsconfig.json --pretty false",
		"start": "node dist/app.js",
		"generate": "typesql migrate status && typesql migrate generate && typesql migrate up && typesql migrate down && typesql migrate latest"
	},
	"dependencies": {
		"@typesql/core": "workspace:*",
		"@typesql/cli": "workspace:*",
		"@typesql/pg": "workspace:*",
		"pg": "catalog:",
		"@types/pg": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/node": "catalog:"
	},
	"consumer": {
		"database": "postgres",
		"artifacts": [
			"db.ts"
		]
	}
}
