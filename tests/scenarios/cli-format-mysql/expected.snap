// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cli-format-mysql > scenario 1`] = `
{
  "artifacts": {
    "app.ts": "import type { Col } from "@typesql/core/mysql";
import { createSql } from "@typesql/mysql";
import { createPool } from "mysql2/promise";

interface DB {
	users: {
		id: Col<"int">;
		name: Col<"varchar">;
		visits: Col<"int">;
	};
}
const pool = createPool({ uri: process.env.DATABASE_URL! });
await pool.query(
	"CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(100) NOT NULL, visits INT NOT NULL)",
);
// The dialect comes from the types: no config, and MySQL's rules apply.
const sql = createSql<DB>(pool);
await sql(
	\`
		INSERT INTO users (id, name, visits)
		VALUES (1, "Ada", 1), (2, 'Bob', 1), (3, 'Cy', 1)
	\`,
).execute();
await sql(
	\`
		INSERT INTO users (id, name, visits)
		VALUES (1, "Ada", 1) AS new # "…" is a string
		ON DUPLICATE KEY UPDATE visits = users.visits + new.visits
	\`,
).execute();
// MySQL names an unaliased column after its text.
export const rows = await sql(
	\`
		SELECT id, visits+0, Visits, \\\`name\\\` AS \\\`Name\\\`
		FROM users
		WHERE visits DIV 1 >= 1
	\`,
).execute();
console.log(rows);
await pool.end();
",
  },
  "compile": {
    "status": 0,
    "stderr": "",
    "stdout": "",
  },
  "compiler": {
    "diagnostics": [],
    "types": {
      "rows": "({ Name: string; Visits: number; id: number; "visits+0": number })[]",
    },
  },
  "generate": {
    "status": 0,
    "stderr": "",
    "stdout": "typesql format: formatted app.ts
",
  },
  "start": {
    "status": 0,
    "stderr": "",
    "stdout": "[
  { id: 1, 'visits+0': 2, Visits: 2, Name: 'Ada' },
  { id: 2, 'visits+0': 1, Visits: 1, Name: 'Bob' },
  { id: 3, 'visits+0': 1, Visits: 1, Name: 'Cy' }
]
",
  },
}
`;
