{
	"name": "prisma-generation-mysql",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node dist/app.js",
		"generate": "prisma generate --no-hints > prisma-generate.log 2>&1 && prisma db push > prisma-push.log 2>&1"
	},
	"dependencies": {
		"@typesql/core": "workspace:*",
		"@typesql/prisma": "workspace:*",
		"prisma": "catalog:",
		"@prisma/client": "catalog:",
		"@prisma/adapter-mariadb": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/node": "catalog:"
	},
	"scenario": {
		"database": "mysql",
		"artifacts": [
			"generated/schema.ts"
		]
	}
}
