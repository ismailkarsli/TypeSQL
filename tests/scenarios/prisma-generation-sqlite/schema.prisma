generator client {
  provider = "prisma-client"
  output = "./generated/client"
  moduleFormat = "esm"
  importFileExtension = "js"
}
generator typesql {
  provider = "typesql-prisma"
  output = "./generated/schema.ts"
}
datasource db {
  provider = "sqlite"
}
model User {
  id Int @id @default(autoincrement())
  name String
  bio String? @map("display_name")
  @@map("users")
}
model Author {
  id Int @id @default(autoincrement())
  name String
  bio String?
}
