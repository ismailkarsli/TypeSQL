{
	"name": "prisma-client-postgres",
	"private": true,
	"type": "module",
	"scripts": {
		"compile": "tsc -p tsconfig.json --pretty false",
		"start": "node dist/app.js",
		"generate": "prisma generate --no-hints > prisma-generate.log && prisma db push > prisma-push.log"
	},
	"dependencies": {
		"@typesql/core": "workspace:*",
		"@typesql/prisma": "workspace:*",
		"prisma": "catalog:",
		"@prisma/client": "catalog:",
		"@prisma/adapter-pg": "catalog:",
		"pg": "catalog:",
		"@types/pg": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/node": "catalog:"
	},
	"consumer": {
		"database": "postgres"
	}
}
