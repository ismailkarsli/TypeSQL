{
	"name": "better-auth-sqlite",
	"private": true,
	"type": "module",
	"scripts": {
		"setup": "node setup.ts",
		"generate": "typesql introspect --dialect sqlite --db \"$SQLITE_PATH\" --out schema.ts",
		"compile": "tsc -p tsconfig.json --pretty false",
		"start": "node dist/app.js"
	},
	"dependencies": {
		"@typesql/core": "workspace:*",
		"@typesql/better-auth": "workspace:*",
		"@typesql/cli": "workspace:*",
		"@typesql/sqlite": "workspace:*",
		"better-auth": "catalog:",
		"@better-fetch/fetch": "catalog:",
		"better-call": "catalog:",
		"jose": "catalog:",
		"kysely": "catalog:",
		"nanostores": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/node": "catalog:"
	},
	"scenario": {
		"database": "sqlite",
		"artifacts": [
			"schema.ts"
		]
	}
}
