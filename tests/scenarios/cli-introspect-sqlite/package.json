{
	"name": "cli-introspect-sqlite",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node dist/app.js",
		"setup": "node setup.ts",
		"generate": "typesql introspect --dialect sqlite --db \"$SQLITE_PATH\" --out schema.ts"
	},
	"dependencies": {
		"@typesql/core": "workspace:*",
		"@typesql/cli": "workspace:*",
		"@typesql/sqlite": "workspace:*"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/node": "catalog:"
	},
	"scenario": {
		"database": "sqlite",
		"artifacts": [
			"schema.ts"
		]
	}
}
