{
  "name": "@typesql/pg",
  "version": "0.1.1",
  "description": "node-postgres (pg) adapter for TypeSQL, with `typesql introspect` to generate a schema from a live database.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailkarsli/typesql.git",
    "directory": "packages/pg"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./introspect": {
      "types": "./dist/introspect/index.d.ts",
      "default": "./dist/introspect/index.js"
    }
  },
  "bin": {
    "typesql": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@typesql/core": "workspace:*"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "homepage": "https://typesql.karsli.net/adapters/pg",
  "bugs": {
    "url": "https://github.com/ismailkarsli/typesql/issues"
  },
  "author": "İsmail Karslı",
  "keywords": [
    "sql",
    "postgres",
    "postgresql",
    "typescript",
    "type-safe",
    "type-level",
    "raw-sql",
    "no-codegen",
    "pg",
    "node-postgres",
    "introspection"
  ]
}
