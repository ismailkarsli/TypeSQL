{
	"name": "@typesql/better-auth",
	"version": "7.2.0",
	"description": "Better Auth database adapter for TypeSQL.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/better-auth"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"@typesql/core": "workspace:^",
		"better-auth": "^1.7.0"
	},
	"devDependencies": {
		"@typesql/core": "workspace:*",
		"better-auth": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"homepage": "https://github.com/ismailkarsli/typesql/tree/main/packages/better-auth#readme",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"sqlite",
		"typescript",
		"type-safe",
		"raw-sql",
		"better-auth",
		"auth",
		"adapter"
	]
}
