{
  "name": "@typesql/core",
  "version": "0.1.2",
  "description": "Type-level Postgres SQL inference for TypeScript. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailkarsli/typesql.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "homepage": "https://typesql.karsli.net",
  "bugs": {
    "url": "https://github.com/ismailkarsli/typesql/issues"
  },
  "author": "İsmail Karslı",
  "keywords": [
    "sql",
    "postgres",
    "postgresql",
    "typescript",
    "type-safe",
    "type-level",
    "raw-sql",
    "no-codegen",
    "sql-parser",
    "database"
  ]
}
