{
	"name": "@typesql/core",
	"version": "0.10.0",
	"description": "Type-level SQL inference for TypeScript: PostgreSQL (tested against PostgreSQL 18's regression suite) and SQLite. Zero runtime dependencies.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/core"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./adapter": {
			"types": "./dist/adapter.d.ts",
			"default": "./dist/adapter.js"
		},
		"./postgres": {
			"types": "./dist/postgres/index.d.ts",
			"default": "./dist/postgres/index.js"
		},
		"./postgres/engine": {
			"types": "./dist/postgres/engine/index.d.ts",
			"default": "./dist/postgres/engine/index.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite/index.d.ts",
			"default": "./dist/sqlite/index.js"
		},
		"./sqlite/engine": {
			"types": "./dist/sqlite/engine/index.d.ts",
			"default": "./dist/sqlite/engine/index.js"
		},
		"./migration": {
			"types": "./dist/migration/index.d.ts",
			"default": "./dist/migration/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"typescript": ">=7.1.0-0"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"libpg-query": "18.1.5",
		"pg": "^8.23.1",
		"postgres": "^3.4.9",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "7.1.0-beta",
		"vitest": "^5.0.4"
	},
	"homepage": "https://typesql.karsli.net",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"sqlite",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen",
		"sql-parser",
		"database"
	]
}
