{
	"name": "@typesql/core",
	"version": "0.7.6",
	"description": "Type-level Postgres SQL inference for TypeScript, tested against PostgreSQL 18's regression suite. Zero runtime dependencies.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/core"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./adapter": {
			"types": "./dist/adapter.d.ts",
			"default": "./dist/adapter.js"
		},
		"./engine": {
			"types": "./dist/engine/index.d.ts",
			"default": "./dist/engine/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"dist/cache/mapper.js"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"typescript": ">=7.0.0-0"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"libpg-query": "18.1.5",
		"pg": "^8.23.1",
		"postgres": "^3.4.9",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "7.1.0-beta",
		"vitest": "^5.0.4"
	},
	"homepage": "https://typesql.karsli.net",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen",
		"sql-parser",
		"database"
	]
}
