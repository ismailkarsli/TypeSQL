{
	"name": "@typesql/core",
	"version": "7.2.0",
	"description": "Type-level SQL inference for TypeScript: PostgreSQL, SQLite, MySQL and MariaDB. Tiny (under 3 kB) with zero runtime dependencies.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/core"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./adapter": {
			"types": "./dist/adapter.d.ts",
			"default": "./dist/adapter.js"
		},
		"./postgres": {
			"types": "./dist/postgres/index.d.ts",
			"default": "./dist/postgres/index.js"
		},
		"./postgres/engine": {
			"types": "./dist/postgres/engine/index.d.ts",
			"default": "./dist/postgres/engine/index.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite/index.d.ts",
			"default": "./dist/sqlite/index.js"
		},
		"./sqlite/engine": {
			"types": "./dist/sqlite/engine/index.d.ts",
			"default": "./dist/sqlite/engine/index.js"
		},
		"./mysql": {
			"types": "./dist/mysql/index.d.ts",
			"default": "./dist/mysql/index.js"
		},
		"./mysql/engine": {
			"types": "./dist/mysql/engine/index.d.ts",
			"default": "./dist/mysql/engine/index.js"
		},
		"./migration": {
			"types": "./dist/migration/index.d.ts",
			"default": "./dist/migration/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"default": "./dist/plugins/index.js"
		},
		"./reserved": {
			"types": "./dist/reserved.d.ts",
			"default": "./dist/reserved.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"mariadb": ">=3",
		"mysql2": ">=3",
		"pg": ">=8",
		"typescript": ">=7.1.0-0"
	},
	"peerDependenciesMeta": {
		"mariadb": {
			"optional": true
		},
		"mysql2": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/pg": "catalog:",
		"mysql2": "catalog:",
		"pg": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"homepage": "https://typesql.karsli.net",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"sqlite",
		"mysql",
		"mariadb",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen",
		"sql-parser",
		"database"
	]
}
