{
	"name": "@typesql/sqlite",
	"version": "0.0.3",
	"description": "SQLite adapter for TypeSQL: node:sqlite, better-sqlite3 and bun:sqlite, with the introspection behind `typesql introspect --dialect sqlite` (@typesql/cli).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/sqlite"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./introspect": {
			"types": "./dist/introspect/index.d.ts",
			"default": "./dist/introspect/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@typesql/core": "workspace:*"
	},
	"devDependencies": {
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "7.1.0-beta"
	},
	"homepage": "https://typesql.karsli.net/adapters/sqlite",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"sqlite",
		"node:sqlite",
		"better-sqlite3",
		"bun",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen"
	]
}
