{
	"name": "@typesql/cli",
	"version": "0.1.1",
	"description": "The typesql command: tracked schema migrations and schema introspection for PostgreSQL and SQLite.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"typesql": "./dist/bin.js"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@typesql/core": "workspace:*",
		"@typesql/pg": "workspace:*",
		"@typesql/sqlite": "workspace:*"
	},
	"peerDependencies": {
		"pg": ">=8"
	},
	"peerDependenciesMeta": {
		"pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "7.1.0-beta"
	},
	"homepage": "https://typesql.karsli.net/guide/introspect",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"sqlite",
		"typescript",
		"cli",
		"introspection"
	]
}
