{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": []
	},
	"include": ["*.ts"]
}
