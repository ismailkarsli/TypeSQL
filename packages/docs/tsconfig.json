{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2024"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"paths": {
			"@typesql/core/adapter": ["../core/src/adapter.ts"],
			"@typesql/core/postgres/engine": ["../core/src/postgres/engine/index.ts"],
			"@typesql/core/postgres": ["../core/src/postgres/index.ts"],
			"@typesql/core": ["../core/src/index.ts"],
			"@typesql/pg": ["../pg/src/index.ts"],
			"@typesql/pg/introspect": ["../pg/src/introspect/index.ts"],
			"@typesql/postgres": ["../postgres/src/index.ts"],
			"@typesql/kysely": ["../kysely/src/index.ts"],
			"@typesql/drizzle": ["../drizzle/src/index.ts"],
			"@typesql/prisma": ["../prisma/src/index.ts"],
			"kysely": ["../kysely/node_modules/kysely"],
			"drizzle-orm": ["../drizzle/node_modules/drizzle-orm"],
			"drizzle-orm/*": ["../drizzle/node_modules/drizzle-orm/*"]
		}
	},
	"include": [".vitepress/*.ts", ".vitepress/*.mts"]
}
