{
	"name": "@typesql/mysql",
	"version": "7.7.1",
	"description": "MySQL and MariaDB adapter for TypeSQL: mysql2, the mariadb connector, PlanetScale and TiDB Cloud serverless, with the introspection behind `typesql introspect --dialect mysql` (@typesql/cli).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/mysql"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./mariadb": {
			"types": "./dist/mariadb.d.ts",
			"default": "./dist/mariadb.js"
		},
		"./planetscale": {
			"types": "./dist/planetscale.d.ts",
			"default": "./dist/planetscale.js"
		},
		"./tidb": {
			"types": "./dist/tidb.d.ts",
			"default": "./dist/tidb.js"
		},
		"./introspect": {
			"types": "./dist/introspect/index.d.ts",
			"default": "./dist/introspect/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@typesql/core": "workspace:*"
	},
	"peerDependencies": {
		"@planetscale/database": ">=1",
		"@tidbcloud/serverless": ">=0.1",
		"mariadb": ">=3",
		"mysql2": ">=3"
	},
	"peerDependenciesMeta": {
		"@planetscale/database": {
			"optional": true
		},
		"@tidbcloud/serverless": {
			"optional": true
		},
		"mariadb": {
			"optional": true
		},
		"mysql2": {
			"optional": true
		}
	},
	"devDependencies": {
		"mysql2": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"homepage": "https://typesql.karsli.net/adapters/mysql",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"mysql",
		"mariadb",
		"mysql2",
		"planetscale",
		"tidb",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen",
		"introspection"
	]
}
