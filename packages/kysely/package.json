{
  "name": "@typesql/kysely",
  "version": "0.0.3",
  "description": "Use Kysely database interfaces (kysely-codegen, prisma-kysely) as a typesql schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailkarsli/typesql.git",
    "directory": "packages/kysely"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@typesql/core": "workspace:*"
  },
  "peerDependencies": {
    "kysely": ">=0.27"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
