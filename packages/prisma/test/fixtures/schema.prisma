// Fixture covering every Prisma scalar on PostgreSQL, optional/list fields, enums, defaults,
// @updatedAt, @map/@@map, @db.* native types, relations, a composite id, a view and multiSchema.
//
// `client/` (gitignored) is generated by `pnpm fixtures` (run by `pnpm typecheck` and the test
// setup). `typesql.ts` is the generator's output, kept as a snapshot: `npx vitest run -u` updates it.

generator client {
  provider        = "prisma-client"
  output          = "./client"
  previewFeatures = ["views"]
}

generator typesql {
  // Runs the generator from source; installed projects use provider = "typesql-prisma".
  provider = "node --import ./test/fixtures/ts-resolve.mjs ./src/bin.ts"
  output   = "./typesql.ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum Role {
  ADMIN
  USER
  GUEST @map("guest")

  @@schema("public")
}

enum Status {
  ACTIVE
  BANNED

  @@map("account_status")
  @@schema("auth")
}

/// Application users.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(200)
  name      String?  @map("display_name")
  role      Role     @default(USER)
  roles     Role[]
  tags      String[]
  bigNum    BigInt
  ratio     Float
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  data      Json?
  avatar    Bytes?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt
  posts     Post[]
  account   Account?

  @@schema("public")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  authorId  Int      @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  publishAt DateTime? @db.Timestamptz(6)
  day       DateTime  @db.Date
  views     Int       @default(0) @db.SmallInt
  score     Float     @db.Real
  cost      Decimal?  @db.Money
  nick      String?   @db.Citext
  code      String    @db.Char(3)
  meta      Json      @db.Json
  ints      Int[]
  slug      String    @default(dbgenerated("gen_slug()"))
  /// Search vector maintained by a trigger.
  search    Unsupported("tsvector")?
  labels    PostLabel[]

  @@map("posts")
  @@schema("public")
}

model PostLabel {
  postId String @db.Uuid
  label  String
  post   Post   @relation(fields: [postId], references: [id])

  @@id([postId, label])
  @@schema("public")
}

model Account {
  id      BigInt  @id @default(autoincrement())
  userId  Int     @unique @map("user_id")
  user    User    @relation(fields: [userId], references: [id])
  status  Status  @default(ACTIVE)
  at      DateTime @db.Time(3)
  ip      String? @db.Inet
  flag    String? @db.Bit(1)

  @@map("accounts")
  @@schema("auth")
}

/// Every remaining `@db.*` type of the PostgreSQL connector, and client-side defaults.
model Native {
  id         String   @id @default(cuid())
  nano       String   @default(nanoid())
  ulid       String   @default(ulid())
  uuid7      String   @default(uuid(7)) @db.Uuid
  fromDb     String   @default(dbgenerated())
  text       String   @db.Text
  varbit     String   @db.VarBit
  xml        String   @db.Xml
  bool       Boolean  @db.Boolean
  int        Int      @db.Integer
  oid        Int      @db.Oid
  big        BigInt   @db.BigInt
  double     Float    @db.DoublePrecision
  ts         DateTime @db.Timestamp(6)
  timetz     DateTime @db.Timetz(6)
  jsonb      Json     @db.JsonB
  bytes      Bytes    @db.ByteA
  decimals   Decimal[]
  labels     String[] @default([])
  stamps     DateTime[] @db.Timestamptz
  label      String   @default("x")
  nullableId Int?     @default(1)

  @@schema("public")
}

view ActiveUser {
  id    Int    @unique
  email String
  name  String? @map("display_name")

  @@map("active_users")
  @@schema("public")
}
