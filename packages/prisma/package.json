{
	"name": "@typesql/prisma",
	"version": "7.7.0",
	"description": "Use a Prisma schema as a TypeSQL schema: convert the generated client's types, or generate an exact schema with the typesql-prisma generator.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/prisma"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./generator": {
			"types": "./dist/generator/api.d.ts",
			"default": "./dist/generator/api.js"
		}
	},
	"bin": {
		"typesql-prisma": "./dist/bin.js"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@typesql/core": "workspace:*"
	},
	"peerDependencies": {
		"@prisma/client": ">=7"
	},
	"devDependencies": {
		"@prisma/client": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"homepage": "https://typesql.karsli.net/adapters/prisma",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"sqlite",
		"mysql",
		"mariadb",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen",
		"prisma",
		"prisma-generator",
		"orm"
	]
}
