{
  "name": "@typesql/drizzle",
  "version": "0.0.1",
  "description": "Use Drizzle ORM table definitions as a typesql schema.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typesql": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45"
  },
  "devDependencies": {
    "@typesql/pg": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
