{
	"name": "@typesql/drizzle",
	"version": "6.1.4",
	"description": "Use Drizzle ORM table definitions as a TypeSQL schema.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/drizzle"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@typesql/core": "workspace:*"
	},
	"peerDependencies": {
		"drizzle-orm": ">=0.45 <1.0.0-0"
	},
	"devDependencies": {
		"@types/pg": "catalog:",
		"drizzle-orm": "catalog:",
		"mysql2": "catalog:",
		"pg": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:"
	},
	"homepage": "https://typesql.karsli.net/adapters/drizzle",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"sqlite",
		"mysql",
		"mariadb",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen",
		"drizzle",
		"drizzle-orm",
		"orm"
	]
}
