{
  "name": "@typesql/drizzle",
  "version": "0.0.2",
  "description": "Use Drizzle ORM table definitions as a typesql schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailkarsli/typesql.git",
    "directory": "packages/drizzle"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@typesql/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45"
  },
  "devDependencies": {
    "@typesql/pg": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
