{
  "name": "typesql",
  "displayName": "TypeSQL",
  "description": "Completions for tables and columns inside TypeSQL's sql() strings, on top of TypeScript 7.",
  "version": "0.0.2",
  "private": true,
  "preview": true,
  "publisher": "typesql",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailkarsli/typesql.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://typesql.karsli.net/guide/editor",
  "bugs": {
    "url": "https://github.com/ismailkarsli/typesql/issues"
  },
  "author": "İsmail Karslı",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sql",
    "postgres",
    "typescript",
    "completions"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "configuration": {
      "title": "TypeSQL",
      "properties": {
        "typesql.completions.enable": {
          "type": "boolean",
          "default": true,
          "description": "Suggest tables, views, schemas and columns inside sql() strings."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "tsc -p tsconfig.build.json && vsce package --no-dependencies --out typesql.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.101.0",
    "@typesql/core": "workspace:*",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.4"
  }
}
