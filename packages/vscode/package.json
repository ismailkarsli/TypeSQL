{
	"name": "typesql",
	"displayName": "TypeSQL",
	"description": "SQL highlighting and completions for tables and columns inside TypeSQL's sql() strings.",
	"version": "3.0.3",
	"private": true,
	"preview": true,
	"publisher": "typesql",
	"icon": "icon.png",
	"galleryBanner": {
		"color": "#4C0519",
		"theme": "dark"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/vscode"
	},
	"homepage": "https://typesql.karsli.net/guide/vscode",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"type": "commonjs",
	"main": "./dist/extension.js",
	"engines": {
		"vscode": "^1.144.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"sql",
		"postgres",
		"typescript",
		"completions",
		"syntax highlighting"
	],
	"activationEvents": [
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:javascript",
		"onLanguage:javascriptreact"
	],
	"contributes": {
		"grammars": [
			{
				"scopeName": "inline.typesql",
				"path": "./syntaxes/sql-injection.tmLanguage.json",
				"injectTo": [
					"source.ts",
					"source.tsx",
					"source.js",
					"source.js.jsx"
				],
				"embeddedLanguages": {
					"meta.embedded.line.sql": "sql",
					"meta.embedded.block.sql": "sql"
				},
				"tokenTypes": {
					"meta.embedded.line.sql - comment - meta.template.expression": "string",
					"meta.embedded.block.sql - comment - meta.template.expression": "string"
				}
			}
		],
		"semanticTokenScopes": [
			{
				"language": "typescript",
				"scopes": {
					"keyword.definition": [
						"keyword.other.sql"
					],
					"enumMember.definition": [
						"constant.language.sql"
					],
					"type.definition": [
						"storage.type.sql"
					],
					"function.definition": [
						"entity.name.function.sql"
					],
					"number.definition": [
						"constant.numeric.sql"
					],
					"regexp.definition": [
						"constant.character.escape.sql"
					],
					"operator.definition": [
						"keyword.operator.sql"
					],
					"parameter.definition": [
						"variable.parameter.positional.sql"
					],
					"variable.definition": [
						"meta.embedded.line.sql"
					],
					"string.definition": [
						"meta.embedded.line.sql"
					]
				}
			},
			{
				"language": "typescriptreact",
				"scopes": {
					"keyword.definition": [
						"keyword.other.sql"
					],
					"enumMember.definition": [
						"constant.language.sql"
					],
					"type.definition": [
						"storage.type.sql"
					],
					"function.definition": [
						"entity.name.function.sql"
					],
					"number.definition": [
						"constant.numeric.sql"
					],
					"regexp.definition": [
						"constant.character.escape.sql"
					],
					"operator.definition": [
						"keyword.operator.sql"
					],
					"parameter.definition": [
						"variable.parameter.positional.sql"
					],
					"variable.definition": [
						"meta.embedded.line.sql"
					],
					"string.definition": [
						"meta.embedded.line.sql"
					]
				}
			},
			{
				"language": "javascript",
				"scopes": {
					"keyword.definition": [
						"keyword.other.sql"
					],
					"enumMember.definition": [
						"constant.language.sql"
					],
					"type.definition": [
						"storage.type.sql"
					],
					"function.definition": [
						"entity.name.function.sql"
					],
					"number.definition": [
						"constant.numeric.sql"
					],
					"regexp.definition": [
						"constant.character.escape.sql"
					],
					"operator.definition": [
						"keyword.operator.sql"
					],
					"parameter.definition": [
						"variable.parameter.positional.sql"
					],
					"variable.definition": [
						"meta.embedded.line.sql"
					],
					"string.definition": [
						"meta.embedded.line.sql"
					]
				}
			},
			{
				"language": "javascriptreact",
				"scopes": {
					"keyword.definition": [
						"keyword.other.sql"
					],
					"enumMember.definition": [
						"constant.language.sql"
					],
					"type.definition": [
						"storage.type.sql"
					],
					"function.definition": [
						"entity.name.function.sql"
					],
					"number.definition": [
						"constant.numeric.sql"
					],
					"regexp.definition": [
						"constant.character.escape.sql"
					],
					"operator.definition": [
						"keyword.operator.sql"
					],
					"parameter.definition": [
						"variable.parameter.positional.sql"
					],
					"variable.definition": [
						"meta.embedded.line.sql"
					],
					"string.definition": [
						"meta.embedded.line.sql"
					]
				}
			}
		],
		"configuration": {
			"title": "TypeSQL",
			"properties": {
				"typesql.completions.enable": {
					"type": "boolean",
					"default": true,
					"description": "Suggest tables, views, schemas and columns inside sql() strings."
				},
				"typesql.semanticHighlighting.enable": {
					"type": "boolean",
					"default": true,
					"description": "Use types to color SQL: highlight the strings of TypeSQL's sql functions under any name, and show other functions' strings as plain strings. Needs the TypeScript 7 extension and a theme with semantic highlighting."
				}
			}
		},
		"configurationDefaults": {
			"editor.tokenColorCustomizations": {
				"[*Dark*][Default High Contrast]": {
					"textMateRules": [
						{
							"scope": [
								"meta.embedded.line.sql",
								"meta.embedded.block.sql"
							],
							"settings": {
								"foreground": "#FFE4E6"
							}
						},
						{
							"scope": [
								"keyword.other.sql",
								"keyword.operator.sql",
								"keyword.operator.cast.sql"
							],
							"settings": {
								"foreground": "#FDA4AF"
							}
						},
						{
							"scope": "storage.type.sql",
							"settings": {
								"foreground": "#FDBA9A"
							}
						},
						{
							"scope": "entity.name.function.sql",
							"settings": {
								"foreground": "#F0ABFC"
							}
						},
						{
							"scope": [
								"constant.numeric.sql",
								"constant.language.sql"
							],
							"settings": {
								"foreground": "#FED7AA"
							}
						},
						{
							"scope": [
								"variable.parameter.positional.sql",
								"variable.parameter.named.sql"
							],
							"settings": {
								"foreground": "#F9A8D4",
								"fontStyle": "bold"
							}
						}
					]
				},
				"[*Light*]": {
					"textMateRules": [
						{
							"scope": [
								"meta.embedded.line.sql",
								"meta.embedded.block.sql"
							],
							"settings": {
								"foreground": "#4C0519"
							}
						},
						{
							"scope": [
								"keyword.other.sql",
								"keyword.operator.sql",
								"keyword.operator.cast.sql"
							],
							"settings": {
								"foreground": "#A51034"
							}
						},
						{
							"scope": "storage.type.sql",
							"settings": {
								"foreground": "#8A2E10"
							}
						},
						{
							"scope": "entity.name.function.sql",
							"settings": {
								"foreground": "#86198F"
							}
						},
						{
							"scope": [
								"constant.numeric.sql",
								"constant.language.sql"
							],
							"settings": {
								"foreground": "#7F1D1D"
							}
						},
						{
							"scope": [
								"variable.parameter.positional.sql",
								"variable.parameter.named.sql"
							],
							"settings": {
								"foreground": "#A1144F",
								"fontStyle": "bold"
							}
						}
					]
				}
			}
		}
	},
	"scripts": {
		"build": "esbuild src/extension.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js",
		"typecheck": "tsrs -p tsconfig.json --noEmit",
		"package": "pnpm run build && vsce package --no-dependencies --out typesql.vsix"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/vscode": "~1.144.0",
		"@typesql/language-server": "workspace:*",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.2",
		"ovsx": "^1.3.0",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "7.1.0-beta"
	}
}
