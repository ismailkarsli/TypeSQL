{
	"name": "@typesql/postgres",
	"version": "0.2.14",
	"description": "postgres.js adapter for TypeSQL.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ismailkarsli/typesql.git",
		"directory": "packages/postgres"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@typesql/core": "workspace:*"
	},
	"peerDependencies": {
		"postgres": ">=3"
	},
	"devDependencies": {
		"postgres": "^3.4.9",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "7.1.0-beta"
	},
	"homepage": "https://typesql.karsli.net/adapters/postgres",
	"bugs": {
		"url": "https://github.com/ismailkarsli/typesql/issues"
	},
	"author": "İsmail Karslı",
	"keywords": [
		"sql",
		"postgres",
		"postgresql",
		"typescript",
		"type-safe",
		"type-level",
		"raw-sql",
		"no-codegen",
		"postgres.js",
		"postgresjs"
	]
}
