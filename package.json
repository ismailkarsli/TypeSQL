{
	"name": "typesql-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "pnpm -r --filter './packages/*' --filter '!@typesql/docs' run build",
		"typecheck": "pnpm -r --filter './packages/*' run typecheck && tsc -p tsconfig.json",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:types": "vitest run --typecheck.only",
		"coverage": "vitest run --coverage",
		"coverage:ratchet": "node scripts/coverage-ratchet.ts",
		"mutate:runtime": "node scripts/mutate-runtime.ts",
		"check:expect-error": "node scripts/check-expect-error.ts",
		"test:pg-regress": "node packages/core/test/pg-regress/run.ts",
		"test:oracle": "node scripts/oracle.ts",
		"fuzz": "node scripts/fuzz.ts",
		"test:pg-ast": "node scripts/pg-ast.ts",
		"mutate:types": "node scripts/type-mutate.ts",
		"pg-regress:setup": "node packages/core/test/pg-regress/setup.ts",
		"bench": "pnpm --filter @typesql/bench run bench",
		"smoke:dist": "node scripts/smoke-dist.ts",
		"check:intents": "node scripts/check-intents.ts",
		"cache-version": "node scripts/cache-version.ts",
		"release": "gh workflow run release.yml --ref main && echo \"Release started: https://github.com/ismailkarsli/typesql/actions/workflows/release.yml\"",
		"docs:dev": "pnpm --filter @typesql/docs run dev",
		"docs:build": "pnpm --filter @typesql/docs run build",
		"docs:preview": "pnpm --filter @typesql/docs run preview",
		"docs:deploy": "pnpm --filter @typesql/docs run deploy",
		"playground": "node scripts/playground.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "5.0.4",
		"fast-check": "^4.10.2",
		"lz-string": "^1.5.0",
		"typescript": "7.1.0-beta",
		"vitest": "^5.0.4"
	}
}
