{
  "name": "typesql-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter '!@typesql/docs' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "coverage": "vitest run --coverage",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "mutate:runtime": "node scripts/mutate-runtime.mjs",
    "check:expect-error": "node scripts/check-expect-error.mjs",
    "test:pg-regress": "node packages/core/test/pg-regress/run.mjs",
    "test:oracle": "node scripts/oracle.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "test:pg-ast": "node scripts/pg-ast.mjs",
    "mutate:types": "node scripts/type-mutate.mjs",
    "pg-regress:setup": "node packages/core/test/pg-regress/setup.mjs",
    "bench": "pnpm --filter @typesql/bench run bench",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "check:intents": "node scripts/check-intents.mjs",
    "cache-version": "node scripts/cache-version.mjs",
    "release": "gh workflow run release.yml --ref main && echo \"Release started: https://github.com/ismailkarsli/typesql/actions/workflows/release.yml\"",
    "docs:dev": "pnpm --filter @typesql/docs run dev",
    "docs:build": "pnpm --filter @typesql/docs run build",
    "docs:preview": "pnpm --filter @typesql/docs run preview",
    "docs:deploy": "pnpm --filter @typesql/docs run deploy",
    "playground": "node scripts/playground.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "fast-check": "^4.10.2",
    "lz-string": "^1.5.0",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.4"
  }
}
