{
  "name": "typesql-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter '!@typesql/docs' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "bench": "pnpm --filter @typesql/bench run bench",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "check:intents": "node scripts/check-intents.mjs",
    "release": "gh workflow run release.yml --ref main && echo \"Release started: https://github.com/ismailkarsli/typesql/actions/workflows/release.yml\"",
    "docs:dev": "pnpm --filter @typesql/docs run dev",
    "docs:build": "pnpm --filter @typesql/docs run build",
    "docs:preview": "pnpm --filter @typesql/docs run preview",
    "docs:deploy": "pnpm --filter @typesql/docs run deploy",
    "playground": "node scripts/playground.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "lz-string": "^1.5.0",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.4"
  }
}
