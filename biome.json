{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!vendor",
			"!!.changeset",
			"!packages/core/src/postgres/engine/lexer/next.ts",
			"!packages/core/src/postgres/engine/typer/pg-functions.ts",
			"!packages/core/src/postgres/schema/pg-catalog.ts",
			"!packages/bench/src",
			"!packages/core/test/oracle/baselines",
			"!packages/core/test/fuzz/baseline.json",
			"!packages/core/test/fuzz/sqlite-baseline.json",
			"!packages/core/test/sqlite/baseline.json",
			"!packages/core/test/fuzz/corpus/candidates.json",
			"!packages/core/test/pg-ast/baseline.json",
			"!packages/core/test/pg-ast/rejections.json",
			"!packages/core/test/pg-regress/baseline.json",
			"!pnpm-lock.yaml",
			"!**/CHANGELOG.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noUselessTypeConstraint": "warn",
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 30 }
				}
			},
			"nursery": {
				"noFloatingPromises": "warn",
				"noMisleadingReturnType": "error",
				"noUnsafeTypeAssertion": "error"
			},
			"suspicious": {
				"noTsIgnore": "error"
			},
			"style": {
				"useAsConstAssertion": "error",
				"useUnifiedTypeSignatures": "info",
				"useReduceTypeParameter": "error"
			}
		}
	},
	"plugins": [
		"./tools/biome/no-array-filter-map.grit",
		"./tools/biome/no-builtin-instanceof.grit",
		"./tools/biome/no-chained-type-assertions.grit",
		"./tools/biome/no-conditional-empty-object-spread.grit",
		"./tools/biome/no-known-value-widening.grit",
		"./tools/biome/no-module-mocking.grit",
		"./tools/biome/no-object-parameters.grit",
		"./tools/biome/no-reduce-accumulator-copy.grit",
		"./tools/biome/no-reflect-apply.grit",
		"./tools/biome/no-reflect-get.grit",
		"./tools/biome/no-spread-new-set.grit",
		"./tools/biome/no-unknown-parameters.grit",
		"./tools/biome/no-unknown-returns.grit",
		"./tools/biome/no-unknown-type-aliases.grit",
		"./tools/biome/no-unsafe-dictionary-type.grit"
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/core/src/sqlite/engine/typer/functions.ts",
				"packages/core/src/schema.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noEmptyInterface": "off"
					}
				}
			}
		}
	]
}
