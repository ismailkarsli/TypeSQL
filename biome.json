{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!.changeset",
			"!packages/core/src/postgres/engine/typer/pg-functions.ts",
			"!packages/core/src/postgres/schema/pg-catalog.ts",
			"!packages/bench/src",
			"!pnpm-lock.yaml",
			"!**/CHANGELOG.md",
			"!tests/.artifacts",
			"!tests/.vitest"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noUselessTypeConstraint": "warn",
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 30
					}
				}
			},
			"nursery": {
				"noFloatingPromises": "warn",
				"noMisleadingReturnType": "error",
				"noUnsafeTypeAssertion": "error"
			},
			"suspicious": {
				"noTsIgnore": "error"
			},
			"style": {
				"useAsConstAssertion": "error",
				"useUnifiedTypeSignatures": "info",
				"useReduceTypeParameter": "error"
			}
		}
	},
	"plugins": [
		"./tools/biome/no-builtin-instanceof.grit",
		"./tools/biome/no-chained-type-assertions.grit",
		"./tools/biome/no-conditional-empty-object-spread.grit",
		"./tools/biome/no-hidden-unknown-and-object-types.grit",
		"./tools/biome/no-known-value-widening.grit",
		"./tools/biome/no-reduce-accumulator-copy.grit",
		"./tools/biome/no-reflection-and-module-mocking.grit",
		"./tools/biome/no-spread-new-set.grit",
		"./tools/biome/no-unknown-parameters.grit",
		"./tools/biome/no-unsafe-dictionary-type.grit"
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/core/src/sqlite/engine/typer/functions.ts",
				"packages/core/src/schema.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noEmptyInterface": "off"
					}
				}
			}
		}
	]
}
