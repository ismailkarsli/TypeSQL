JsCallExpression(callee=or {
	JsStaticMemberExpression(member=or {
		"assign",
		"from",
		"concat",
		"slice",
		"toSpliced",
		"toSorted",
		"toReversed",
		"with"
	}),
	JsComputedMemberExpression(),
	JsParenthesizedExpression(),
	TsAsExpression(),
	TsTypeAssertionExpression(),
	TsNonNullAssertionExpression(),
	TsSatisfiesExpression()
}) as $copy where {
	$copy <: member_call($owner, $method),
	$method <: or {
		"assign",
		"from",
		"concat",
		"slice",
		"toSpliced",
		"toSorted",
		"toReversed",
		"with"
	},
	$copy <: within function_like() as $callback,
	$callback <: or {
		JsArrowFunctionExpression(parameters=JsParameters(items=[
			JsFormalParameter(binding=JsIdentifierBinding() as $accumulator),

			...
		])),
		JsArrowFunctionExpression(parameters=JsIdentifierBinding() as $accumulator),
		JsFunctionExpression(parameters=JsParameters(items=[
			JsFormalParameter(binding=JsIdentifierBinding() as $accumulator),

			...
		]))
	},
	$callback <: within JsCallExpression() as $reducer,
	$reducer <: member_call($_, or {
		"reduce",
		"reduceRight"
	}),
	$reducer <: JsCallExpression(arguments=JsCallArguments(args=or {
		[$first],
		[$first, $initial]
	})),
	$first <: wrapped_function(),
	$first <: contains or {
		JsArrowFunctionExpression(),
		JsFunctionExpression()
	} as $function,
	$function <: $callback,
	$copy <: JsCallExpression(arguments=JsCallArguments(args=$arguments)),
	or {
		and {
			$method <: "assign",
			$owner <: unwrapped_identifier(global("Object")),
			$arguments <: [wrapped_object(), ...],
			$arguments <: some unwrapped_identifier(accumulator_16($callback, $accumulator, JsDebuggerStatement()))
		},
		and {
			$method <: "from",
			$owner <: unwrapped_identifier(global("Array")),
			$arguments <: [
				unwrapped_identifier(accumulator_16($callback, $accumulator, JsDebuggerStatement())),

				...
			]
		},
		and {
			$method <: or {
				"concat",
				"slice",
				"toSpliced",
				"toSorted",
				"toReversed",
				"with"
			},
			$owner <: unwrapped_identifier(accumulator_16($callback, $accumulator, JsDebuggerStatement())),
			$initial <: known_array_16(JsDebuggerStatement())
		}
	},
	register_diagnostic(span=$copy, message="Do not copy the reducer accumulator on every iteration; growing copies can cause quadratic work. Mutate a fresh, locally owned accumulator and return it, or use an iterator pipeline or flatMap.", severity="error")
}
