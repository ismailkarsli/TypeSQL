				or {
					$arguments <: TsTypeArguments(ts_type_argument_list=[$c1, ...]),
					$d1 <: TsDefaultTypeClause(ty=$c1)
				},
				or {
					or {
						and { $aliased <: dictionary_slot($q1), $c1 <: unsafe_value_2() },
						and { $aliased <: value_slot($q1), $c1 <: dictionary_position_2() }
					},
					and {
						$parameters <: TsTypeParameters(items=[
							$_, TsTypeParameter(name=$q2, default=$d2), ...
						]),
						or {
							$arguments <: TsTypeArguments(ts_type_argument_list=[
								$_, $c2, ...
							]),
							and {
								$d2 <: TsDefaultTypeClause(ty=$x2),
								or {
									and { $x2 <: forwards_parameter($q1), $c2 = $c1 },
									$c2 = $x2
								}
							}
						},
						or {
							and { $aliased <: dictionary_slot($q2), $c2 <: unsafe_value_2() },
							and {
								$aliased <: value_slot($q2),
								$c2 <: dictionary_position_2()
							}
						}
					}
				}
			}
		}
	}
}

pattern unsafe_value_1() {
	or {
		TsUnknownType(),
		TsAnyType(),
		TsNonPrimitiveType(),
		empty_object(),
		TsParenthesizedType(ty=unsafe_value_1()),
		readonly_operator(unsafe_value_1()),
		TsUnionType(types=some unsafe_value_1()),
		TsIntersectionType(types=$members) where {
			or {
				$members <: some or {
					TsAnyType(),
					TsParenthesizedType(ty=TsAnyType())
				},
				$members <: every unsafe_value_1()
			}
		},
		builtin(wrapper_names()) as $wrapper where {
			$wrapper <: TsReferenceType(type_arguments=TsTypeArguments(ts_type_argument_list=[
				$wrapped, ...
			])),
			$wrapped <: unsafe_value_1()
		},
		TsReferenceType(name=$name, type_arguments=.) where {
			$name <: not wrapper_names(),
			$name <: empty_interface($name)
		},
		TsReferenceType(name=JsReferenceIdentifier() as $name, type_arguments=$arguments) as $reference where {
			$reference <: visible_alias($name, $parameters, $aliased),
			$reference <: applied_value_1($arguments, $parameters, $aliased)
		}
	}
}

pattern unsafe_dictionary_1() {
	or {
		TsObjectType(members=some TsIndexSignatureTypeMember(type_annotation=TsTypeAnnotation(ty=unsafe_value_1()))),
		TsMappedType(mapped_type=TsTypeAnnotation(ty=unsafe_value_1())),
		TsParenthesizedType(ty=unsafe_dictionary_1()),
		readonly_operator(unsafe_dictionary_1()),
		builtin(wrapper_names()) as $wrapper where {
			$wrapper <: TsReferenceType(type_arguments=TsTypeArguments(ts_type_argument_list=[
				$wrapped, ...
			])),
			$wrapped <: dictionary_position_1()
