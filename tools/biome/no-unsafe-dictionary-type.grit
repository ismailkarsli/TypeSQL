pattern applied_value_2($arguments, $parameters, $aliased) {
	$_ where {
		or {
			$aliased <: unsafe_value_3(),
			and {
				$parameters <: TsTypeParameters(items=[
					TsTypeParameter(name=$q1, default=$d1), ...
				]),
