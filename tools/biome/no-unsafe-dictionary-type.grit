pattern dictionary_position_1() {
	or {
		unsafe_dictionary_1(),
		TsParenthesizedType(ty=dictionary_position_1()),
		TsReferenceType(name=JsReferenceIdentifier() as $name, type_arguments=$arguments) as $reference where {
