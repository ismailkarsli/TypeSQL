			$name <: empty_interface($name)
		}
	}
}

pattern unsafe_dictionary_3() {
	or {
		TsObjectType(members=some TsIndexSignatureTypeMember(type_annotation=TsTypeAnnotation(ty=unsafe_value_3()))),
		TsMappedType(mapped_type=TsTypeAnnotation(ty=unsafe_value_3())),
		TsParenthesizedType(ty=unsafe_dictionary_3()),
		readonly_operator(unsafe_dictionary_3()),
		builtin(wrapper_names()) as $wrapper where {
			$wrapper <: TsReferenceType(type_arguments=TsTypeArguments(ts_type_argument_list=[
				$wrapped, ...
			])),
			$wrapped <: dictionary_position_3()
		},
		builtin(`Record`) as $record where {
			$record <: TsReferenceType(type_arguments=TsTypeArguments(ts_type_argument_list=[
				$_, $value
			])),
			$value <: unsafe_value_3()
		},
		builtin(or {
			`Pick`,
			`Omit`
		}) as $picked where {
			$picked <: TsReferenceType(type_arguments=TsTypeArguments(ts_type_argument_list=[
				$source, ...
			])),
			$source <: dictionary_position_3()
		}
	}
}

pattern dictionary_position_3() {
	or {
		unsafe_dictionary_3(),
		TsParenthesizedType(ty=dictionary_position_3())
	}
}

pattern outermost() {
	$dictionary where {
		$dictionary <: not within TsTypeConstraintClause(),
		$dictionary <: not within or {
			TsReferenceType() as $outer where {
				$outer <: not $dictionary,
				$outer <: dictionary_position_0()
			},
			or {
				TsObjectType(),
				TsMappedType()
			} as $outer where {
				$outer <: unsafe_dictionary_0(),
				$outer <: not $dictionary
			}
		}
	}
}

pattern alias_reference() {
	bubble TsReferenceType(type_arguments=$arguments) as $dictionary where {
		or {
			$arguments <: TsTypeArguments(),
			$dictionary <: within TsTypeAliasDeclaration()
		},
		$dictionary <: dictionary_position_0(),
		$dictionary <: outermost(),
		register_diagnostic(span=$dictionary, message="This dictionary value type gives callers no concrete contract. Use an owner/schema-derived value type and parse external payloads before insertion.", severity="error")
	}
}

pattern resolved_alias_reference() {
	bubble TsReferenceType(name=$name, type_arguments=$arguments) as $dictionary where {
		or {
			$arguments <: TsTypeArguments(),
			$dictionary <: within TsTypeAliasDeclaration()
		},
		$dictionary <: not type_parameter_bound($name),
		$dictionary <: outermost(),
		register_diagnostic(span=$dictionary, message="This dictionary value type gives callers no concrete contract. Use an owner/schema-derived value type and parse external payloads before insertion.", severity="error")
	}
}

pattern alias_may_be_dictionary($parameters, $aliased) {
	$_ where {
		or {
			$aliased <: dictionary_position_1(),
			and {
				$parameters <: TsTypeParameters(items=[TsTypeParameter(name=$q1), ...]),
				$aliased <: or {
					dictionary_slot($q1),
					value_slot($q1)
				}
			},
			and {
				$parameters <: TsTypeParameters(items=[
					$_, TsTypeParameter(name=$q2), ...
				]),
				$aliased <: or {
					dictionary_slot($q2),
					value_slot($q2)
				}
			}
		}
	}
}

or {
	or {
		TsReferenceType(name=$candidate_name) where {
			$candidate_name <: r"Record|Pick|Omit|Readonly|Partial|Required|NonNullable"
		},
		TsObjectType(),
		TsMappedType()
	} as $dictionary where {
		$dictionary <: unsafe_dictionary_0(),
		$dictionary <: outermost(),
		register_diagnostic(span=$dictionary, message="This dictionary value type gives callers no concrete contract. Use an owner/schema-derived value type and parse external payloads before insertion.", severity="error")
	},
	TsTypeAliasDeclaration(binding_identifier=$alias, type_parameters=$parameters, ty=$aliased) as $declaration where {
		$aliased <: or {
			TsReferenceType(),
			TsObjectType(),
			TsMappedType(),
			TsParenthesizedType(),
			TsTypeOperatorType()
		},
		or {
			and {
				$parameters <: .,
				$aliased <: dictionary_position_1(),
				$declaration <: within scope_body($items),
				maybe $items <: contains and { TsReferenceType(name=$alias),
				resolved_alias_reference() } until alias_shadow($alias)
			},
			and {
				$parameters <: TsTypeParameters(),
				$declaration <: alias_may_be_dictionary($parameters, $aliased),
				$declaration <: within scope_body($items),
				maybe $items <: contains and { TsReferenceType(name=$alias),
				alias_reference() } until alias_shadow($alias)
			}
		},
		maybe and {
			$items <: contains TsInferType(name=$alias),
			$items <: contains and { TsConditionalType(extends_type=contains TsInferType(name=$alias)),
			bubble TsConditionalType(check_type=$checked, extends_type=contains TsInferType(name=$inferred), false_type=$otherwise) where {
				maybe $checked <: contains and { TsReferenceType(name=$inferred),
				alias_reference() },
				maybe $otherwise <: contains and { TsReferenceType(name=$inferred),
				alias_reference() }
			} } until alias_shadow_without_infer($alias)
		}
	},
	or {
		TsIndexSignatureTypeMember(type_annotation=TsTypeAnnotation(ty=$value)) as $dictionary where {
			$dictionary <: not within TsObjectType()
		},
		TsIndexSignatureClassMember(type_annotation=TsTypeAnnotation(ty=$value)) as $dictionary
	} where {
		$value <: unsafe_value_0(),
		register_diagnostic(span=$dictionary, message="This dictionary value type gives callers no concrete contract. Use an owner/schema-derived value type and parse external payloads before insertion.", severity="error")
	}
}
