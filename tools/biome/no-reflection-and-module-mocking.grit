engine biome(1.0)
language js(typescript)

pattern value_declares($name) {
	or {
		JsFunctionDeclaration(id=$b) where { $b <: $name },
		JsClassDeclaration(id=$b) where { $b <: $name },
		JsExport(export_clause=or {
			JsFunctionDeclaration(id=$b),
			JsClassDeclaration(id=$b)
		}) where { $b <: $name },
		$statement where {
			$statement <: not or {
				JsFunctionDeclaration(),
				JsClassDeclaration()
			},
			$statement <: contains JsIdentifierBinding() as $b where {
				$b <: $name
			} until or {
				JsFunctionDeclaration(),
				JsFunctionExpression(),
				JsArrowFunctionExpression(),
				JsClassDeclaration(),
				JsClassExpression(),
				JsObjectExpression(),
				JsBlockStatement(),
				JsFunctionBody()
			}
		}
	}
}

pattern binds_value($name) {
	or {
		JsModule(items=some value_declares($name)),
		JsScript(statements=some value_declares($name)),
		JsFunctionBody(statements=some value_declares($name)),
		JsBlockStatement(statements=some value_declares($name)),
		TsModuleBlock(items=some value_declares($name)),
		JsStaticInitializationBlockClassMember(statements=some value_declares($name)),
		JsCaseClause(consequent=some value_declares($name)),
		JsDefaultClause(consequent=some value_declares($name)),
		or {
			JsFunctionDeclaration(parameters=$scope),
			JsFunctionExpression(parameters=$scope),
			JsArrowFunctionExpression(parameters=$scope),
			JsMethodClassMember(parameters=$scope),
			JsMethodObjectMember(parameters=$scope),
			JsConstructorClassMember(parameters=$scope),
			JsSetterClassMember(parameter=$scope),
			JsSetterObjectMember(parameter=$scope),
			JsCatchClause(declaration=$scope),
			JsForStatement(initializer=$scope),
			JsForInStatement(initializer=$scope),
			JsForOfStatement(initializer=$scope)
		} where {
			$scope <: or {
				JsIdentifierBinding() as $b where { $b <: $name },
				contains JsIdentifierBinding() as $b where { $b <: $name } until or {
					JsFunctionExpression(),
					JsArrowFunctionExpression(),
					JsObjectExpression()
				}
			}
		}
	}
}

pattern unparenthesized($inner) {
	or {
		$inner,
		JsParenthesizedExpression(expression=$inner),
		JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=$inner)),
		JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=$inner)))
	}
}

// Regex literals are wrapped in `or` because Grit rejects them as bare pattern arguments.
pattern imports_from($local, $module, $export) {
	and { contains JsModuleSource() as $source where { $source <: $module },
	contains or {
		JsShorthandNamedImportSpecifier(local_name=$binding) where {
			$binding <: $export
		},
		JsNamedImportSpecifier(name=$imported, local_name=$binding) where {
			$imported <: $export
		}
	} where { $binding <: $local } }
}

pattern framework_import($local) {
	JsImport() as $import where {
		$import <: or {
			imports_from($local, or { r"[\"']vitest[\"']" }, "vi"),
			imports_from($local, or { r"[\"']@jest/globals[\"']" }, "jest")
		}
	}
}

pattern member_call($object, $member_name, $quoted_member) {
	JsCallExpression(callee=unparenthesized(or {
		JsStaticMemberExpression(object=unparenthesized(JsIdentifierExpression(name=$object)), member=$member) where {
			$member <: $member_name
		},
		JsComputedMemberExpression(object=unparenthesized(JsIdentifierExpression(name=$object)), member=$member) where {
			$member <: $quoted_member
		}
	}))
}

or {
	member_call($name, "apply", or { r"[\"']apply[\"']" }) as $call where {
		$name <: "Reflect",
		$call <: not within binds_value($name),
		register_diagnostic(span=$call, message="Replace `Reflect.apply` with a typed function call. Model dynamic dispatch behind a named interface.", severity="error")
	},
	member_call($name, "get", or { r"[\"']get[\"']" }) as $call where {
		$name <: "Reflect",
		$call <: not within binds_value($name),
		register_diagnostic(span=$call, message="Replace `Reflect.get` with typed property access. Parse dynamic input into a named domain type before reading it.", severity="error")
	},
	member_call($name, or {
		"doMock",
		"mock",
		"unstable_mockModule"
	}, or { r"[\"'](?:doMock|mock|unstable_mockModule)[\"']" }) as $call where {
		or {
			and {
				$name <: or {
					"vi",
					"jest"
				},
				$call <: not within binds_value($name)
			},
			and {
				$call <: within JsModule(items=some framework_import($name)),
				$call <: not within $scope where {
					$scope <: binds_value($name),
					$scope <: not JsModule()
				}
			}
		},
		register_diagnostic(span=$call, message="Replace module mocking with dependency injection through a real interface, service layer, or faithful test implementation.", severity="error")
	}
}
