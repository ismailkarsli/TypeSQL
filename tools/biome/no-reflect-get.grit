engine biome(1.0)
language js(typescript)

pattern value_declares($name) {
	or {
		JsFunctionDeclaration(id=$b) where { $b <: $name },
		JsClassDeclaration(id=$b) where { $b <: $name },
		JsExport(export_clause=or {
			JsFunctionDeclaration(id=$b),
			JsClassDeclaration(id=$b)
		}) where { $b <: $name },
		$statement where {
			$statement <: not or {
				JsFunctionDeclaration(),
				JsClassDeclaration()
			},
			$statement <: contains JsIdentifierBinding() as $b where { $b <: $name } until or {
				JsFunctionDeclaration(),
				JsFunctionExpression(),
				JsArrowFunctionExpression(),
				JsClassDeclaration(),
				JsClassExpression(),
				JsObjectExpression(),
				JsBlockStatement(),
				JsFunctionBody()
			}
		}
	}
}

pattern binds_value($name) {
	or {
		JsModule(items=some value_declares($name)),
		JsScript(statements=some value_declares($name)),
		JsFunctionBody(statements=some value_declares($name)),
		JsBlockStatement(statements=some value_declares($name)),
		TsModuleBlock(items=some value_declares($name)),
		JsStaticInitializationBlockClassMember(statements=some value_declares($name)),
		JsCaseClause(consequent=some value_declares($name)),
		JsDefaultClause(consequent=some value_declares($name)),
		or {
			JsFunctionDeclaration(parameters=$scope),
			JsFunctionExpression(parameters=$scope),
			JsArrowFunctionExpression(parameters=$scope),
			JsMethodClassMember(parameters=$scope),
			JsMethodObjectMember(parameters=$scope),
			JsConstructorClassMember(parameters=$scope),
			JsSetterClassMember(parameter=$scope),
			JsSetterObjectMember(parameter=$scope),
			JsCatchClause(declaration=$scope),
			JsForStatement(initializer=$scope),
			JsForInStatement(initializer=$scope),
			JsForOfStatement(initializer=$scope)
		} where {
			$scope <: or {
				JsIdentifierBinding() as $b where { $b <: $name },
				contains JsIdentifierBinding() as $b where { $b <: $name } until or {
					JsFunctionExpression(),
					JsArrowFunctionExpression(),
					JsObjectExpression()
				}
			}
		}
	}
}

pattern unparenthesized($inner) {
	or {
		$inner,
		JsParenthesizedExpression(expression=$inner),
		JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=$inner)),
		JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=$inner)))
	}
}

JsCallExpression(callee=unparenthesized(or {
	JsStaticMemberExpression(object=unparenthesized(JsIdentifierExpression(name=$name)), member=$member) where {
		$member <: "get"
	},
	JsComputedMemberExpression(object=unparenthesized(JsIdentifierExpression(name=$name)), member=$member) where {
		$member <: r"[\"']get[\"']"
	}
})) as $call where {
	$name <: "Reflect",
	$call <: not within binds_value($name),
	register_diagnostic(span=$call, message="Replace `Reflect.get` with typed property access. Parse dynamic input into a named domain type before reading it.", severity="error")
}
