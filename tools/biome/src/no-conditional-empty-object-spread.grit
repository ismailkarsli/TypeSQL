language js(typescript)

#include unparenthesized

pattern empty_object() { unparenthesized(JsObjectExpression(members=[])) }

JsSpread(argument=unparenthesized(or {
	JsConditionalExpression(consequent=empty_object()),
	JsConditionalExpression(alternate=empty_object())
})) as $spread where {
	$spread <: within or {
		JsObjectExpression(),
		JsArrayExpression(),
		JsCallArguments()
	} as $owner,
	$owner <: JsObjectExpression(),
	register_diagnostic(span=$spread, message="This conditional spread hides property omission behind an empty object. Build the object in separate statements and add the property only when present.", severity="error")
}
