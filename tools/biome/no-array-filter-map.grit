JsCallExpression(callee=or {
	JsStaticMemberExpression(member=or {
		"map",
		"filter"
	}),
	JsComputedMemberExpression(),
	JsParenthesizedExpression(),
	TsAsExpression(),
	TsTypeAssertionExpression(),
	TsNonNullAssertionExpression(),
	TsSatisfiesExpression()
}) as $chain where {
	$chain <: member_call($inner, $outer),
	$outer <: or {
		"map",
		"filter"
	},
	$inner <: wrapped_call(),
	$inner <: contains JsCallExpression() as $call,
	$call <: member_call($receiver, $first),
	or { and { $outer <: "map", $first <: "filter" }, and { $outer <: "filter", $first <: "map" } },
	$receiver <: known_array_16(JsDebuggerStatement()),
	register_diagnostic(span=$chain, message="Avoid consecutive array filter/map passes. Use flatMap or a loop, preserving callback order, indexes, and filtering semantics. Explicit lazy iterator pipelines are allowed.", severity="error")
}
