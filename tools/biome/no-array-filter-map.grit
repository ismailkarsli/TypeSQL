				$declarator
			}))
		}
	}
}

pattern known_array_8($seen) {
	array_chain() as $expression where {
		$expression <: contains or {
			JsArrayExpression(),
			JsIdentifierExpression()
		} as $base,
		$base <: or {
			JsArrayExpression(),
			array_identifier($seen, $declarator, known_array_7(or {
